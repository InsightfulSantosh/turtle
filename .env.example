# Exact model commits should replace "main" before a production index is built.
NEXT_PUBLIC_TURTLE_API_URL=http://localhost:8080

FASHION_MATCHING_MODEL_ID=Marqo/marqo-fashionSigLIP
FASHION_MATCHING_MODEL_REVISION=main
FASHION_MATCHING_DEVICE=auto
FASHION_MATCHING_BATCH_SIZE=16
FASHION_MATCHING_CANDIDATE_COUNT=100
FASHION_MATCHING_TOP_K=5
FASHION_MINIMUM_SCORE=0.62

FASHION_PREPROCESSING_VERSION=rgb-exif-pad-v1
FASHION_MAX_IMAGE_BYTES=8388608
FASHION_MAX_IMAGE_PIXELS=40000000
FASHION_MIN_IMAGE_DIMENSION=32
FASHION_PAD_TO_SQUARE=true
FASHION_CROP_UNIFORM_BACKGROUND=false

# Two-stage visual retrieval: FashionSigLIP gets the top 50 eligible candidates.
# Multi-scale body-only DINOv2 then verifies pattern/structure. The final visual
# blend is FashionSigLIP 25%, body DINOv2 35%, masked colour 30%, texture 10%.
FASHION_DINO_RERANK_ENABLED=true
FASHION_DINO_MODEL_ID=facebook/dinov2-base
FASHION_DINO_MODEL_REVISION=main
FASHION_DINO_CANDIDATE_COUNT=50
FASHION_DINO_WEIGHT_GRID=0.5833333333
FASHION_DINO_REQUIRE_SAME_ITEM_TYPE=true
FASHION_DINO_REQUIRE_SAME_DESIGN=true
FASHION_DINO_REQUIRE_SAME_COLOUR_FAMILY=true
FASHION_PATTERN_GATE_ENABLED=true
FASHION_PATTERN_MAX_DISTANCE=0.42

# Garment-only visual evidence. Grounding DINO finds the item-type-specific
# garment box and SAM 2.1 traces it. Colour and texture are unavailable if no
# mask passes the quality gate; the original image is retained only for neural
# candidate retrieval/detail fallback. Pin both model revisions for deployment.
FASHION_APPEARANCE_MASK_ENABLED=true
FASHION_GARMENT_SEGMENTATION_ENABLED=true
FASHION_GARMENT_SEGMENTATION_BORDER_FALLBACK=true
FASHION_GARMENT_DETECTOR_MODEL_ID=IDEA-Research/grounding-dino-tiny
FASHION_GARMENT_DETECTOR_REVISION=main
FASHION_GARMENT_SAM2_MODEL_ID=facebook/sam2.1-hiera-small
FASHION_GARMENT_SAM2_REVISION=main
FASHION_GARMENT_DETECTOR_THRESHOLD=0.35
FASHION_GARMENT_TEXT_THRESHOLD=0.25
FASHION_GARMENT_MINIMUM_COVERAGE=0.04
FASHION_GARMENT_MAXIMUM_COVERAGE=0.88
FASHION_APPEARANCE_NEURAL_WEIGHT=0.60
FASHION_APPEARANCE_COLOUR_WEIGHT=0.30
FASHION_APPEARANCE_TEXTURE_WEIGHT=0.10

# Weights are renormalized over only the signals available for each query/result.
FASHION_IMAGE_WEIGHT=0.70
FASHION_ATTRIBUTE_WEIGHT=0.20
FASHION_TEXT_WEIGHT=0.10

QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
FASHION_COLLECTION_PREFIX=turtle-fashion
FASHION_COLLECTION_ALIAS=turtle-fashion-active

# Required for remote image URLs; local manifest paths do not use this setting.
ALLOWED_IMAGE_DOMAINS=images.example.com,cdn.example.com
