# Exact model commits should replace "main" before a production build is run.
FASHION_MATCHING_MODEL_ID=Marqo/marqo-fashionSigLIP
FASHION_MATCHING_MODEL_REVISION=main
FASHION_MATCHING_DEVICE=auto
FASHION_MATCHING_BATCH_SIZE=16

FASHION_PREPROCESSING_VERSION=rgb-exif-pad-v1
FASHION_MAX_IMAGE_BYTES=16777216
FASHION_MAX_IMAGE_PIXELS=40000000
FASHION_MIN_IMAGE_DIMENSION=32
FASHION_PAD_TO_SQUARE=true

# Visual-only retrieval: FashionSigLIP gets the top 50 same-item-type candidates.
# Multi-scale DINO verifies pattern/structure for every candidate. Four dominant
# garment colours are compared with perceptual CIEDE2000 distance and enforced
# as a hard visual gate; the displayed source image is never modified.
FASHION_DINO_RERANK_ENABLED=true
FASHION_DINO_MODEL_ID=facebook/dinov2-base
FASHION_DINO_MODEL_REVISION=main
FASHION_DINO_CANDIDATE_COUNT=50
FASHION_DINO_WEIGHT_GRID=0.5833333333
FASHION_DINO_REQUIRE_SAME_ITEM_TYPE=true
FASHION_DINO_REQUIRE_SAME_DESIGN=false
FASHION_VISUAL_ONLY_RANKING=true
FASHION_PATTERN_GATE_ENABLED=true
FASHION_PATTERN_MAX_DISTANCE=0.42
FASHION_COLOUR_GATE_ENABLED=true
FASHION_COLOUR_MAX_DISTANCE=0.20

FASHION_APPEARANCE_NEURAL_WEIGHT=0.45
FASHION_APPEARANCE_COLOUR_WEIGHT=0.45
FASHION_APPEARANCE_TEXTURE_WEIGHT=0.10

# Versioned upload service. Set TURTLE_RUN_VISION=false only for lightweight
# lifecycle/UI development; production runs should keep full visual inference.
TURTLE_DATA_ROOT=DATA
TURTLE_ANALYSIS_ROOT=DATA/analysis-service
TURTLE_RUN_VISION=true
TURTLE_ALLOWED_ORIGINS=http://localhost:3000
TURTLE_API_URL=http://127.0.0.1:8000
