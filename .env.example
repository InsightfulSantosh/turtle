# Exact model commits should replace "main" before a production index is built.
NEXT_PUBLIC_TURTLE_API_URL=http://localhost:8080

FASHION_MATCHING_MODEL_ID=Marqo/marqo-fashionSigLIP
FASHION_MATCHING_MODEL_REVISION=main
FASHION_MATCHING_DEVICE=auto
FASHION_MATCHING_BATCH_SIZE=16
FASHION_MATCHING_CANDIDATE_COUNT=100
FASHION_MATCHING_TOP_K=5
FASHION_MINIMUM_SCORE=0.62

FASHION_PREPROCESSING_VERSION=rgb-exif-pad-v1
FASHION_MAX_IMAGE_BYTES=8388608
FASHION_MAX_IMAGE_PIXELS=40000000
FASHION_MIN_IMAGE_DIMENSION=32
FASHION_PAD_TO_SQUARE=true
FASHION_CROP_UNIFORM_BACKGROUND=false

# Weights are renormalized over only the signals available for each query/result.
FASHION_IMAGE_WEIGHT=0.70
FASHION_ATTRIBUTE_WEIGHT=0.20
FASHION_TEXT_WEIGHT=0.10

QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
FASHION_COLLECTION_PREFIX=turtle-fashion
FASHION_COLLECTION_ALIAS=turtle-fashion-active

# Required for remote image URLs; local manifest paths do not use this setting.
ALLOWED_IMAGE_DOMAINS=images.example.com,cdn.example.com
