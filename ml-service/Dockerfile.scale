FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ENABLE_API_DOCS=false

WORKDIR /app
COPY ml-service/requirements-scale.txt ml-service/requirements.txt ./
RUN pip install --no-cache-dir --requirement requirements-scale.txt

COPY ml-service/season_intelligence ./season_intelligence
COPY ml-service/service.py ml-service/worker.py ./
COPY app/generated-data.json ./app/generated-data.json

RUN useradd --create-home --uid 10001 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=2)"

CMD ["uvicorn", "service:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "2", "--proxy-headers"]
